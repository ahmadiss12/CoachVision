# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Python
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.venv/
**/venv/

# Node / Expo
**/node_modules/
**/.expo/
**/.next/

# Local secrets/env
**/.env
**/.env.local
!**/.env.example

# Local db or runtime dumps
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log
**/output*.txt
**/streaming_test*.txt
**/pregeneration_test*.txt

# Local archives and large/generated ML artifacts
*.rar
*.zip
**/pose_landmarker.task
**/models/*.pkl
**/squat_dataset/

# Generated benchmark clips: ~2 MB of JSON, reproducible from a seeded
# generator with `python scripts/make_synthetic_clips.py`. Hand-labelled
# recordings under backend/fixtures/ are deliberately NOT ignored -- the
# labelling is the work, and landmark coordinates carry no image data.
backend/fixtures/**/synthetic_*

# Store assets kept local: uploaded straight to Play Console / YouTube,
# never needed in the repo, and video files bloat clone size permanently.
store-assets/*.mp4
store-assets/*.mov
