APP_NAME=CoachVision Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/coachvision

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=7

# Benchmark clip recording (docs/COUNTER_BENCHMARK.md).
# Saves the pose landmarks of live workouts to disk to build the counter
# accuracy dataset. This records body movement data from whoever uses the app,
# so it is off by default and rejected unless ENVIRONMENT=development.
CLIP_RECORDING_ENABLED=false
CLIP_RECORDING_DIR=fixtures
